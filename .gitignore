# Binaires Go
/bin/
*.exe
*.test
*.out

# SDK TypeScript (clients/ts) — node_modules + build, régénérables
clients/ts/node_modules/
clients/ts/dist/
*.tgz

# Env & secrets (jamais dans le repo)
.env
.env.*
!.env.example
*.pem
*.key

# Archives d'exports générées (bind mount du compose) — seul le dossier est versionné
/data/exports/*
!/data/exports/.gitkeep

# Config locale Claude Code
.claude/settings.local.json

# Index CodeGraph (volumineux, régénérable via `codegraph index`)
.codegraph/

# OS / éditeurs
.DS_Store
*.swp
