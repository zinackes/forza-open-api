# Config locale de dev. Copier en .env (gitignored) et ajuster si besoin.
# `task` charge .env (dotenv) ; docker compose lit aussi .env pour les ports.

# Ports hôtes exposés par docker compose (mappés sur 5432/6379/8080 conteneur).
# À changer si un autre service occupe déjà le port côté hôte.
PG_HOST_PORT=5432
VALKEY_HOST_PORT=6379
API_HOST_PORT=8080

# DSN utilisés par l'API (task run). Doivent matcher les ports hôtes ci-dessus.
DATABASE_URL=postgres://forza:forza@localhost:5432/forza?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Serveur HTTP.
API_ADDR=:8080
LOG_LEVEL=info
