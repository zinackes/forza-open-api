# Config locale de dev. Copier en .env (gitignored) et ajuster si besoin.
# `task` charge .env (dotenv) ; docker compose lit aussi .env pour les ports.

# Ports hôtes exposés par docker compose (mappés sur 5432/6379/8080 conteneur).
# À changer si un autre service occupe déjà le port côté hôte.
PG_HOST_PORT=5432
VALKEY_HOST_PORT=6379
API_HOST_PORT=8080

# DSN utilisés par l'API (task run). Doivent matcher les ports hôtes ci-dessus.
DATABASE_URL=postgres://forza:forza@localhost:5432/forza?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Serveur HTTP.
API_ADDR=:8080
LOG_LEVEL=info

# Rate limit. Fenêtre glissante en secondes (quota par clé : api_keys.rate_limit).
# ANON_RATE_LIMIT : quota par IP du trafic SANS clé API (0 = désactivé : la
# protection de l'anonyme relève du bord, Cloudflare).
# CLIENT_IP_HEADER : en-tête proxy de confiance portant l'IP cliente réelle
# (ex. CF-Connecting-IP derrière Cloudflare). Vide = IP de la connexion TCP.
# Ne jamais pointer X-Forwarded-For si l'origine est joignable en direct.
RATE_LIMIT_WINDOW=60
ANON_RATE_LIMIT=0
CLIENT_IP_HEADER=
